# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=sed
pkgver=4.9
pkgrel=0
arch="all"
pkgdesc="GNU stream editor"
url="https://www.gnu.org/software/sed"
license="GPL-3.0-or-later"
depends="qnx-io-sock"
makedepends="qnx-io-sock-dev"
subpackages="$pkgname-doc"
source="https://mirrors.kernel.org/gnu/sed/sed-$pkgver.tar.xz"

build() {
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --mandir=/usr/share/man \
        --disable-i18n \
        --disable-nls
    make
}

package() {
    make DESTDIR="$pkgdir" install
}
sha512sums="
